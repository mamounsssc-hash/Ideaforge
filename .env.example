# Copy to  backend/.env  and edit. All optional — defaults keep everything local & free.

# ---- Transcription ----
# Only two models are supported and pre-downloaded: large-v3 (best) or medium (lighter).
IDEAFORGE_WHISPER_MODEL=large-v3      # large-v3 | medium
IDEAFORGE_WHISPER_DEVICE=auto         # auto | cpu | cuda
IDEAFORGE_DEFAULT_LANGUAGE=en         # empty for auto-detect

# ---- Clip selection ----
IDEAFORGE_MIN_CLIP_SECONDS=15
IDEAFORGE_MAX_CLIP_SECONDS=60
IDEAFORGE_TARGET_CLIP_COUNT=10

# ---- Optional smart re-ranking (Qwen3-VL / Hermes / Ollama / LM Studio) ----
# Leave LLM_ENABLED=false to run 100% on heuristics (never depends on a model).
IDEAFORGE_LLM_ENABLED=false
IDEAFORGE_LLM_BASE_URL=http://localhost:11434/v1   # Ollama example
IDEAFORGE_LLM_MODEL=qwen2.5:7b
IDEAFORGE_LLM_VISION=false            # true when pointing at a Qwen3-VL server (sends keyframes)

# ---- Reframe / output ----
IDEAFORGE_REFRAME_ENABLED=true
IDEAFORGE_TARGET_WIDTH=1080
IDEAFORGE_TARGET_HEIGHT=1920

# ---- Optional B-roll + faceless backgrounds (Pexels free API key). ----
# Get a free key at https://www.pexels.com/api/
IDEAFORGE_PEXELS_API_KEY=

# ---- Text-to-speech for the faceless "Create" mode ----
# auto tries piper (offline) then edge-tts (online, free). edge-tts needs internet.
IDEAFORGE_TTS_ENGINE=auto             # auto | piper | edge
# For fully-offline TTS, point these at a piper binary + a voice model:
IDEAFORGE_PIPER_BIN=
IDEAFORGE_PIPER_VOICE=
